{
  "name": "syncforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SyncForge — Real-Time CRDT Collaborative Document Editor",
  "workspaces": [
    "packages/*",
    "tests/e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/server & npm run dev --workspace=packages/client",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:server": "npm run build --workspace=packages/server",
    "build:client": "npm run build --workspace=packages/client",
    "start": "npm run start --workspace=packages/server",
    "test": "npm run test --workspace=packages/server",
    "test:client": "npm run test --workspace=@syncforge/client",
    "test:e2e": "npm run test --workspace=tests/e2e",
    "test:all": "npm run test && npm run test:client && npm run test:e2e",
    "benchmark": "npm run benchmark --workspace=packages/server"
  },
  "keywords": [
    "crdt",
    "yjs",
    "collaborative-editor",
    "real-time",
    "tiptap",
    "prosemirror",
    "websockets"
  ],
  "author": "SyncForge Team",
  "license": "MIT"
}
