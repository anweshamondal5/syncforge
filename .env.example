# ==============================================================================
# SyncForge Environment Configuration Example
# ==============================================================================

# Backend Server Environment
NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# PostgreSQL Database Configuration (Leave empty to use embedded SQLite fallback)
DATABASE_URL=postgresql://syncforge_user:syncforge_pass@localhost:5432/syncforge_db

# CORS Configuration (comma-separated list of allowed origins or * for dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://syncforge.onrender.com

# Persistence Write Buffering & Snapshot Compaction
DOC_SAVE_DEBOUNCE_MS=2000
DOC_SNAPSHOT_THRESHOLD=50

# Rate Limiting & WebSocket Guardrails
MAX_PAYLOAD_BYTES=5242880
RATE_LIMIT_MSGS_PER_SEC=300

# Frontend Client Public Variables (Vite)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
